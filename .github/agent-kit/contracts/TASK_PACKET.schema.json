{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookdb.local/schemas/agent/task-packet.schema.json",
  "title": "BookDB Agent TaskPacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "title",
    "task_type",
    "state",
    "objective",
    "in_scope",
    "out_of_scope",
    "assigned_agent",
    "dependencies",
    "acceptance_criteria",
    "verification",
    "required_reviewers"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,80}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "task_type": {
      "enum": [
        "PLANNING",
        "IMPLEMENTATION",
        "REPAIR",
        "REVIEW_SUPPORT",
        "INTEGRATION_REPAIR",
        "INCIDENT",
        "RELEASE"
      ]
    },
    "state": {
      "enum": [
        "DRAFT",
        "TRIAGED",
        "SCOPED",
        "DECISION_REQUIRED",
        "DECOMPOSED",
        "READY_TO_LEASE",
        "LEASED",
        "IN_PROGRESS",
        "BLOCKED",
        "HANDOFF_SUBMITTED",
        "REVIEW_PENDING",
        "CHANGES_REQUESTED",
        "APPROVED",
        "INTEGRATION_PENDING",
        "INTEGRATED",
        "VERIFYING",
        "DONE",
        "CANCELLED",
        "ESCALATED"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "in_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assigned_agent": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "base_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "command",
          "expected"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        }
      }
    },
    "required_reviewers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
