# BookDB .gitignore
#
# Go
bin/
dist/
*.test
*.out
coverage.*
go.work.sum
vendor/

# Build output
bookdb
bookdb.exe
*.exe
out/

# Node / WebUI
web/node_modules/**
web/dist/**
web/coverage/**
web/.vite/**
web/.turbo/**
web/playwright-report/**
web/test-results/**
*.tsbuildinfo

# Env / local secret material (NEVER commit real credentials)
.env
.env.local
.env.*.local
*.secret
*.pem
*.key
*.key.*
*.p12
*.pfx
*.jks
.secrets/
secrets/

# Tool caches
.go-cache/
.gocache/
.npm/
.pnpm-store/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editors and IDEs
.idea/
*.swp
*~
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json

# Local artifacts
logs/
data/
tmp/
artifacts/

# Temporary recovery and sandbox paths
.agent-state/
.codex/

# Compose local volumes
compose-data/
