# BookDB Environment Variables (development defaults)
#
# Copy to `.env` (git-ignored) and edit for local overrides.
# Never commit real credentials. All values in this file are development
# placeholders that match `compose.yaml`.
#
# Precedence (see docs/11_TECHNICAL_DOCUMENTATION.md):
#   defaults < YAML config < environment < secret refs / runtime
#
# Secrets: use BOOKDB_SECRET_* vars at production time; never commit.

## Application identity
BOOKDB_ENV=development
BOOKDB_LOG_LEVEL=info
BOOKDB_LOG_FORMAT=json
BOOKDB_API_ADDR=:8080
BOOKDB_METRICS_ADDR=:9090

## PostgreSQL (canonical)
# In dev, connect via PgBouncer; in direct tests, connect to Postgres.
BOOKDB_DATABASE_URL=postgres://bookdb:bookdb@pgbouncer:6432/bookdb?sslmode=disable
# Fallback direct URL for the migrate / integration-test runner:
BOOKDB_DATABASE_URL_DIRECT=postgres://bookdb:bookdb@postgres:5432/bookdb?sslmode=disable
BOOKDB_DB_MAX_OPEN_CONNS=50
BOOKDB_DB_MAX_IDLE_CONNS=10
BOOKDB_DB_CONN_MAX_LIFETIME_MIN=30

## NATS + JetStream (durable work/event bus)
BOOKDB_NATS_URL=nats://nats:4222
BOOKDB_NATS_JETSTREAM_ENABLED=true
BOOKDB_NATS_STREAM_BOOKDB=BOOKDB
# Per-subject JetStream stream name (events). Bootstrap subject:
BOOKDB_NATS_BOOTSTRAP_SUBJECT=bookdb.bootstrap.v1

## Valkey (cache, rate limit, ephemeral coordination only)
BOOKDB_VALKEY_URL=redis://valkey:6379/0

## OpenSearch (production catalog search projection — rebuildable)
BOOKDB_OPENSEARCH_URL=http://opensearch:9200
BOOKDB_OPENSEARCH_TIMEOUT_SECONDS=10
# Default index alias; versioned index names are derived in code, e.g.
# bookdb_works_v1, bookdb_works_v2, ... Aliases are read-only by default.
BOOKDB_OPENSEARCH_INDEX_ALIAS_WORKS=bookdb_works
BOOKDB_OPENSEARCH_INDEX_ALIAS_EDITIONS=bookdb_editions
BOOKDB_OPENSEARCH_INDEX_ALIAS_PEOPLE=bookdb_people
BOOKDB_OPENSEARCH_INDEX_ALIAS_SERIES=bookdb_series

## S3-compatible object storage (assets)
# In the development compose, this is SeaweedFS via S3 API.
BOOKDB_S3_ENDPOINT=http://seaweed-s3:8333
BOOKDB_S3_ACCESS_KEY=bookdb
BOOKDB_S3_SECRET_KEY=bookdb-dev-secret-do-not-use-in-prod
BOOKDB_S3_BUCKET=bookdb-assets
BOOKDB_S3_REGION=us-east-1
BOOKDB_S3_FORCE_PATH_STYLE=true

## Authentication / OIDC (placeholders for M1)
# Local accounts: hash algorithm is Argon2id with parameters recorded in code.
BOOKDB_AUTH_LOCAL_ENABLED=true
# OIDC: leave empty in development. Enable via:
#BOOKDB_OIDC_ISSUER=https://auth.example.com/realms/bookdb
#BOOKDB_OIDC_CLIENT_ID=bookdb
#BOOKDB_OIDC_CLIENT_SECRET_REF=secret://oidc-client-secret   # never in source
#BOOKDB_OIDC_AUDIENCE=bookdb-api
#BOOKDB_OIDC_DISCOVERY=true
# API keys: generated per user/scope; stored as Argon2id hashes (or HMAC) in
# the auth service. M1 defines the exact storage layout.

## Source registry
# YAML file with the source registry (schema in schemas/source-registry.schema.json)
BOOKDB_SOURCE_REGISTRY_PATH=config/source-registry.yaml

## Observability (OpenTelemetry + Prometheus)
BOOKDB_OTEL_ENABLED=true
BOOKDB_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
BOOKDB_OTEL_SERVICE_NAME=bookdb
BOOKDB_OTEL_TRACES_SAMPLER=parentbased_always_on
BOOKDB_METRICS_ENABLED=true
BOOKDB_METRICS_NAMESPACE=bookdb

## Feature flags (defaults)
BOOKDB_FEATURE_OUTBOX_ENABLED=true
BOOKDB_FEATURE_SEARCH_INDEX_ENABLED=true
BOOKDB_FEATURE_ASSET_PIPELINE_ENABLED=true

## Development-only: relaxed CORS for WebUI
BOOKDB_DEV_CORS_ORIGINS=http://localhost:5173
