{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookdb.local/schemas/agent/authority-lease.schema.json",
  "title": "BookDB Agent AuthorityLease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lease_id",
    "task_id",
    "agent_id",
    "status",
    "base_commit",
    "branch",
    "worktree",
    "write_allow",
    "write_deny",
    "allowed_actions",
    "forbidden_actions",
    "required_reviewers"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "lease_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "EXPIRED",
        "REVOKED",
        "COMPLETED"
      ]
    },
    "base_commit": {
      "type": "string",
      "minLength": 7
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "worktree": {
      "type": "string",
      "minLength": 1
    },
    "write_allow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "write_deny": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "required_reviewers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "parameters": {
      "type": "object"
    }
  }
}
