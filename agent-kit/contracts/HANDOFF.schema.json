{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookdb.local/schemas/agent/handoff.schema.json",
  "title": "BookDB Agent Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "agent_id",
    "lease_id",
    "result",
    "summary",
    "changed_files",
    "commits",
    "commands_run",
    "verification_results",
    "decisions",
    "blockers",
    "risks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "result": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED",
        "FAILED"
      ]
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "status",
          "evidence"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIP"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "followups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
