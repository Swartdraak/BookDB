{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookdb.local/schemas/agent/delegation-ledger.schema.json",
  "title": "DelegationLedger",
  "type": "object",
  "required": [
    "schema_version",
    "objective_id",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "objective_id": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "agent_id",
          "state"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "lease_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
