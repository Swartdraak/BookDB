{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookdb.local/schemas/agent/review-report.schema.json",
  "title": "BookDB Agent ReviewReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "task_id",
    "reviewer_agent",
    "review_type",
    "result",
    "scope",
    "checks",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "review_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "reviewer_agent": {
      "type": "string"
    },
    "review_type": {
      "enum": [
        "DOMAIN_REVIEW",
        "ARCHITECTURE_REVIEW",
        "QA_REVIEW",
        "SECURITY_REVIEW",
        "SOURCE_POLICY_REVIEW",
        "HA_REVIEW",
        "API_COMPAT_REVIEW",
        "PERFORMANCE_REVIEW",
        "DOCUMENTATION_REVIEW"
      ]
    },
    "result": {
      "enum": [
        "APPROVE",
        "CHANGES_REQUESTED",
        "BLOCKED",
        "ESCALATE"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "WARN",
              "N/A"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "finding"
        ],
        "properties": {
          "severity": {
            "enum": [
              "BLOCKER",
              "MAJOR",
              "MINOR",
              "INFO"
            ]
          },
          "finding": {
            "type": "string"
          },
          "required_action": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
